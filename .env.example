# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/palmkicks"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL of the site (http://localhost:3000 in development)
AUTH_URL="http://localhost:3000"

# --- Admin bootstrap, read only by `npm run db:seed` ---
# Two admin accounts are created if they do not already exist. Each admin must
# change the password on first login. Use unique, strong values (10-72 chars).
ADMIN_SEED_USERNAME=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_SUPERUSER=""
ADMIN_SEED_SUPERPASSWORD=""

# --- Cloudinary (product image uploads) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Gmail SMTP; use an app password) ---
# If unset, orders still work but no confirmation email is sent.
EMAIL_USER=""
EMAIL_PASS=""

# --- Public settings ---
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_LOGO_URL=""
NEXT_PUBLIC_ENVIRONMENT="development"

# --- Extra values read only by `npm run db:seed` (initial site configuration) ---
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_TIKTOK_URL=""
